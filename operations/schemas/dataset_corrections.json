{
  "id": "dataset_corrections",
  "title": "Dataset correction proposals",
  "type": "object",
  "required": [
    "summary",
    "proposals",
    "unresolved"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 800
    },
    "proposals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "patch_type",
          "target",
          "before",
          "after",
          "requires_human_review"
        ],
        "properties": {
          "patch_type": {
            "type": "string",
            "enum": [
              "sample_mapping",
              "group_mapping",
              "reference_classification",
              "field_mapping",
              "unit_mapping",
              "scale_factor",
              "exclude_measurement",
              "restore_measurement",
              "derived_metric_recovery",
              "metadata_value"
            ]
          },
          "target": {
            "type": "string"
          },
          "before": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "after": {
            "type": [
              "string",
              "number",
              "boolean",
              "null"
            ]
          },
          "field": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "requires_human_review": {
            "type": "boolean"
          },
          "finding_id": {
            "type": "string"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "target",
          "reason"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "maxItems": 3,
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
