# Required on the first start. The container stores only a password hash.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Local/default deployment
MIFP_BIND=127.0.0.1
MIFP_PORT=8000
TRUSTED_HOSTS=localhost,127.0.0.1
SESSION_COOKIE_SECURE=0
TRUST_PROXY=0

# Public HTTPS deployment (used by compose.public.yaml)
MIFP_DOMAIN=mifp.eu

# Optional resource tuning
MIFP_IMAGE_TAG=local
MIFP_MEMORY_LIMIT=1g
MIFP_CPU_LIMIT=2.0
MIFP_TMP_SIZE=3g
GUNICORN_WORKERS=1
GUNICORN_THREADS=4
STORAGE_MIN_FREE_MB=0
LOG_FORMAT=json
