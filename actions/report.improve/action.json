{
  "id": "report.improve",
  "type": "HYBRID",
  "category": "report",
  "role": "researcher",
  "title": "AI writing help",
  "short_title": "Writing help",
  "purpose": "Improve a selected document section or, for common actions, revise the current document in bounded blocks without changing scientific source data.",
  "strategy": "LabFlow selects only the relevant Markdown section(s), supplies the shared Experiment Brief and evidence pack, asks the model for replacement blocks, then merges them back into the document.",
  "output": "text",
  "mutation_scope": "report",
  "policies": [
    "policy.scientific-provenance"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.08,
      "tool": "report.collect-edit-blocks"
    },
    {
      "id": "edit",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "text",
      "timeout_ms": 240000,
      "foreach": "collect.blocks",
      "weight": 0.84,
      "max_output_tokens": 12288,
      "deadline_ms": 180000,
      "max_retries": 1,
      "min_output_tokens": 1600,
      "target_output_tokens": 6000
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.08,
      "capture_result": true,
      "tool": "report.store-edit-blocks"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.active-document",
  "visibility": "public",
  "requires": [],
  "input": {
    "context": "report"
  }
}
