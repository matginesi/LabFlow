{
  "id": "results.interpret",
  "title": "Interpret experiment results",
  "short_title": "Interpret results",
  "category": "results",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Build a deterministic, evidence-backed interpretation of the current Results without calling an AI provider.",
  "strategy": "LabFlow summarizes calculated quality, rankings, FW/RV agreement, reproducibility and descriptive relationships from the current deterministic analysis. No causal mechanism is inferred.",
  "policies": [],
  "contract": {
    "target": {
      "kind": "results_bundle",
      "cardinality": "one"
    },
    "context": {
      "profile": "results",
      "scope": "current_results"
    },
    "result": {
      "format": "json",
      "schema": "results_interpretation",
      "kind": "derived_annotation"
    },
    "effect": {
      "mode": "store_derived",
      "writes": [
        "experiment.actionData.annotations.results.interpret"
      ]
    },
    "guards": [
      "dataset.loaded",
      "results.available"
    ]
  },
  "execution": {
    "mode": "deterministic",
    "result_step": "build",
    "steps": [
      {
        "id": "build",
        "type": "DETERMINISTIC",
        "tool": "results.build-interpretation",
        "capture_result": true,
        "weight": 0.82
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "tool": "results.store-interpretation",
        "weight": 0.18
      }
    ]
  },
  "ui": {
    "command": "/interpret",
    "routes": [
      "experiment-results"
    ]
  }
}
