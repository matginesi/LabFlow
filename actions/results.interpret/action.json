{
  "id": "results.interpret",
  "title": "Interpret experiment results",
  "short_title": "Interpret results",
  "category": "results",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Produce a structured scientific interpretation of deterministic Results without recalculating or modifying measurements.",
  "strategy": "The model receives deterministic summary statistics, rankings, anomalies and open findings. It must separate observations from hypotheses, cite evidence identifiers where available, and expose limitations and next checks.",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "contract": {
    "target": {
      "kind": "results_bundle",
      "cardinality": "one"
    },
    "context": {
      "profile": "results",
      "scope": "current_results"
    },
    "result": {
      "format": "json",
      "schema": "results_interpretation",
      "kind": "derived_annotation"
    },
    "effect": {
      "mode": "store_derived",
      "writes": [
        "experiment.actionData.annotations.results.interpret"
      ]
    },
    "guards": [
      "dataset.loaded",
      "results.available"
    ]
  },
  "execution": {
    "mode": "hybrid",
    "result_step": "interpret",
    "steps": [
      {
        "id": "interpret",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "json",
        "schema": "results_interpretation",
        "thinking": "off",
        "timeout_ms": 120000,
        "max_output_tokens": 1400,
        "deadline_ms": 120000,
        "max_retries": 1,
        "min_output_tokens": 100,
        "target_output_tokens": 600,
        "max_input_tokens": 9000
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "tool": "results.store-interpretation"
      }
    ]
  }
}
