{
  "id": "design.infer",
  "title": "Suggest missing experiment design",
  "short_title": "Suggest design",
  "category": "design",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Suggest missing qualitative solution chemistry, device-stack and/or fabrication-process fields for one selected experiment; insufficient evidence is a valid non-error outcome.",
  "strategy": "One selected experiment per run. The model suggests only missing chemistry/stack/process content; LabFlow owns target identity, validates applicability, stores a proposal, and never overwrites source or researcher values automatically.",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "contract": {
    "target": {
      "kind": "design_experiment",
      "cardinality": "one",
      "selection_param": "deviceId"
    },
    "context": {
      "profile": "design",
      "scope": "selected_design_experiment"
    },
    "result": {
      "format": "json",
      "schema": "design_suggestion",
      "kind": "proposal"
    },
    "effect": {
      "mode": "store_proposal",
      "writes": [
        "experiment.actionData.proposals.design.infer",
        "experiment.actionData.status.design.infer"
      ]
    },
    "guards": [
      "dataset.loaded",
      "design.incomplete_target"
    ]
  },
  "execution": {
    "mode": "hybrid",
    "result_step": "infer",
    "steps": [
      {
        "id": "collect",
        "type": "DETERMINISTIC",
        "weight": 0.1,
        "tool": "design.collect-selected"
      },
      {
        "id": "infer",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "json",
        "schema": "design_suggestion",
        "thinking": "off",
        "timeout_ms": 90000,
        "weight": 0.8,
        "max_output_tokens": 1600,
        "deadline_ms": 90000,
        "max_retries": 2,
        "min_output_tokens": 80,
        "target_output_tokens": 650,
        "max_input_tokens": 6500,
        "validate_with": "design.validate-coverage",
        "provider_schema": false
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "weight": 0.1,
        "tool": "design.store-proposal"
      }
    ]
  },
  "ui": {
    "command": "/design",
    "routes": [
      "experiment-design"
    ],
    "bindings": {
      "deviceId": "selectedDesignDeviceId"
    }
  }
}
