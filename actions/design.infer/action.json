{
  "id": "design.infer",
  "type": "HYBRID",
  "category": "design",
  "role": "researcher",
  "title": "Complete design with AI",
  "short_title": "Complete design",
  "purpose": "Produce one complete, provenance-labelled design proposal for the selected experiment using dataset evidence first and model knowledge only for missing information.",
  "strategy": "One bounded request for one selected experiment. Known Working Copy values are preserved; evidence-backed and knowledge-only proposals are labelled separately.",
  "output": "json",
  "mutation_scope": "",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.1,
      "tool": "design.collect-selected"
    },
    {
      "id": "infer",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "design_reconstruct",
      "thinking": "on",
      "timeout_ms": 180000,
      "weight": 0.8,
      "max_output_tokens": 6144,
      "deadline_ms": 150000,
      "max_retries": 1,
      "min_output_tokens": 1200,
      "target_output_tokens": 2800
    },
    {
      "id": "validate",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.validate-coverage"
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.store-proposal"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.design-selection",
  "visibility": "public",
  "requires": [],
  "input": {
    "context": "design"
  }
}
