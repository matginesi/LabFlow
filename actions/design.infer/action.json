{
  "id": "design.infer",
  "title": "Complete experiment design",
  "short_title": "Complete design",
  "category": "design",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Complete missing qualitative Design domains using experiment evidence, compatible Cabinet resources and compact Knowledge Base design hints first; ask the model only for domains that remain unresolved.",
  "strategy": "One selected experiment per run. A deterministic resolver builds review candidates before any model request. If all requested domains are covered, the Action completes with zero provider calls. Otherwise one compact work unit contains only the unresolved domains; deterministic candidates always win when merging the result.",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "contract": {
    "target": {
      "kind": "design_experiment",
      "cardinality": "one",
      "selection_param": "deviceId"
    },
    "context": {
      "profile": "design",
      "scope": "selected_design_experiment"
    },
    "result": {
      "format": "json",
      "schema": "design_suggestion",
      "kind": "proposal"
    },
    "effect": {
      "mode": "store_proposal",
      "writes": [
        "experiment.actionData.proposals.design.infer",
        "experiment.actionData.status.design.infer"
      ]
    },
    "guards": [
      "dataset.loaded",
      "design.incomplete_target"
    ]
  },
  "execution": {
    "mode": "hybrid",
    "result_step": "infer",
    "steps": [
      {
        "id": "collect",
        "type": "DETERMINISTIC",
        "weight": 0.28,
        "tool": "design.collect-selected"
      },
      {
        "id": "infer",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "json",
        "schema": "design_suggestion",
        "thinking": "off",
        "timeout_ms": 70000,
        "weight": 0.54,
        "max_output_tokens": 500,
        "deadline_ms": 70000,
        "max_retries": 0,
        "min_output_tokens": 60,
        "target_output_tokens": 180,
        "max_input_tokens": 1500,
        "validate_with": "design.validate-coverage",
        "provider_schema": false,
        "foreach": "collect.ai_work"
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "weight": 0.18,
        "tool": "design.store-proposal"
      }
    ]
  },
  "ui": {
    "command": "/design",
    "routes": [
      "experiment-design"
    ],
    "bindings": {
      "deviceId": "ui.selectedDesignDeviceId"
    }
  }
}
