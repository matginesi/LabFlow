{
  "id": "design.infer",
  "type": "HYBRID",
  "category": "design",
  "role": "researcher",
  "title": "Suggest experiment design",
  "short_title": "Suggest design",
  "purpose": "Suggest missing solution chemistry and device-stack data for the selected experiment from source evidence, relevant scientific Knowledge Base records and cautious model inference.",
  "strategy": "One bounded request for one experiment. Suggestions are stored for researcher review and are never applied automatically.",
  "output": "json",
  "mutation_scope": "",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.1,
      "tool": "design.collect-selected"
    },
    {
      "id": "infer",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "design_reconstruct",
      "thinking": "off",
      "timeout_ms": 90000,
      "weight": 0.8,
      "max_output_tokens": 1400,
      "deadline_ms": 90000,
      "max_retries": 0,
      "min_output_tokens": 100,
      "target_output_tokens": 520,
      "max_input_tokens": 8000
    },
    {
      "id": "validate",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.validate-coverage"
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.store-proposal"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.design-selection",
  "visibility": "public",
  "requires": [],
  "input": {
    "context": "design",
    "knowledge": {
      "limit": 8,
      "kinds": [
        "material",
        "solution",
        "stack",
        "process",
        "concept"
      ],
      "query_hint": "SnO2 TiO2 PTAA 2PACz spiro C60 BCP PEAI perovskite absorber stack solution precursor"
    }
  }
}
