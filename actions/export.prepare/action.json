{
  "id": "export.prepare",
  "title": "Prepare export metadata",
  "short_title": "Prepare metadata",
  "category": "export",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Prepare missing or weak export metadata for NOMAD first and Ready-PV second, using current ExperimentData, Workspace, Process and Cabinet evidence without modifying canonical scientific data.",
  "strategy": "One bounded review-only pass over the current export projections. The model may propose export-only values only for fields LabFlow marks as missing or incomplete. It must prefer experiment/workspace/process/cabinet evidence, cite the supplied source, preserve uncertainty, and leave unsupported fields unresolved. Accepted suggestions become projection overrides only after explicit user review.",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "contract": {
    "target": {
      "kind": "export_projection",
      "cardinality": "one"
    },
    "context": {
      "profile": "export",
      "scope": "current_export_projection"
    },
    "result": {
      "format": "json",
      "schema": "export_preparation",
      "kind": "proposal"
    },
    "effect": {
      "mode": "store_proposal",
      "writes": [
        "experiment.actionData.proposals.export.prepare",
        "experiment.actionData.status.export.prepare"
      ]
    },
    "guards": [
      "dataset.loaded",
      "export.metadata_needs_attention"
    ]
  },
  "execution": {
    "mode": "hybrid",
    "result_step": "prepare",
    "steps": [
      {
        "id": "prepare",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "json",
        "schema": "export_preparation",
        "thinking": "off",
        "timeout_ms": 90000,
        "deadline_ms": 90000,
        "max_retries": 1,
        "min_output_tokens": 100,
        "target_output_tokens": 700,
        "max_output_tokens": 1600,
        "max_input_tokens": 9000,
        "validate_with": "export.validate-preparation",
        "provider_schema": false,
        "weight": 0.86
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "tool": "export.store-preparation",
        "weight": 0.14
      }
    ]
  },
  "ui": {
    "command": "/prepare-export",
    "routes": [
      "experiment-export"
    ]
  }
}
