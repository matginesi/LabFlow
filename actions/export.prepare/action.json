{
  "id": "export.prepare",
  "title": "Prepare export metadata",
  "short_title": "Prepare metadata",
  "category": "export",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Prepare a deterministic review list for missing NOMAD and Ready-PV metadata without inventing values or calling an AI provider.",
  "strategy": "LabFlow reuses only explicit current projection/workspace/process values when a conservative field alias is known. Everything else remains unresolved for human review.",
  "policies": [],
  "contract": {
    "target": {
      "kind": "export_projection",
      "cardinality": "one"
    },
    "context": {
      "profile": "export",
      "scope": "current_export_projection"
    },
    "result": {
      "format": "json",
      "schema": "export_preparation",
      "kind": "proposal"
    },
    "effect": {
      "mode": "store_proposal",
      "writes": [
        "experiment.actionData.proposals.export.prepare",
        "experiment.actionData.status.export.prepare"
      ]
    },
    "guards": [
      "dataset.loaded",
      "export.metadata_needs_attention"
    ]
  },
  "execution": {
    "mode": "deterministic",
    "result_step": "build",
    "steps": [
      {
        "id": "build",
        "type": "DETERMINISTIC",
        "tool": "export.build-preparation",
        "capture_result": true,
        "weight": 0.82
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "tool": "export.store-preparation",
        "weight": 0.18
      }
    ]
  },
  "ui": {
    "command": "/prepare-export",
    "routes": [
      "experiment-export"
    ]
  }
}
