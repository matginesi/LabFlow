{
  "id": "analysis.enrich",
  "type": "HYBRID",
  "category": "analysis",
  "role": "automatic",
  "title": "Enrich experiment brief",
  "short_title": "Experiment brief",
  "purpose": "Add a compact scientific interpretation layer to the deterministic Experiment Brief using experiment facts and a small relevant Knowledge Base retrieval.",
  "strategy": "Facts first. Retrieved literature may support labelled hypotheses and recommended checks, but never becomes evidence about the experiment or changes source data and deterministic results.",
  "output": "json",
  "mutation_scope": "",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "enrich",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "experiment_brief",
      "thinking": "off",
      "timeout_ms": 180000,
      "weight": 0.85,
      "max_output_tokens": 3072,
      "deadline_ms": 90000,
      "max_retries": 0,
      "min_output_tokens": 500,
      "target_output_tokens": 1100
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.15,
      "tool": "analysis.store-brief-enrichment"
    }
  ],
  "visibility": "internal",
  "version": 1,
  "input_scope": "experiment-brief",
  "requires": [],
  "input": {
    "context": "brief",
    "rag": {
      "source": "knowledge_base",
      "mode": "ranked",
      "limit": 6,
      "query_hint": "objective variables comparison mechanism"
    }
  }
}
