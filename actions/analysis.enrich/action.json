{
  "id": "analysis.enrich",
  "type": "HYBRID",
  "category": "analysis",
  "role": "automatic",
  "title": "Enrich experiment context",
  "short_title": "Experiment context",
  "purpose": "Add only the scientific meaning that deterministic analysis cannot establish directly: likely objective, variables, useful comparisons, labelled hypotheses and missing metadata.",
  "strategy": "Deterministic facts first. This is an optional semantic context layer, never a second analysis pass: it does not recalculate metrics, change source data, or decide scientific truth. Automatic import enrichment is deliberately small and fail-fast.",
  "output": "json",
  "mutation_scope": "",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "enrich",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "experiment_brief",
      "thinking": "off",
      "timeout_ms": 45000,
      "weight": 0.85,
      "max_output_tokens": 700,
      "deadline_ms": 45000,
      "max_retries": 0,
      "min_output_tokens": 100,
      "target_output_tokens": 320,
      "max_input_tokens": 6000
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.15,
      "tool": "analysis.store-brief-enrichment"
    }
  ],
  "visibility": "internal",
  "version": 1,
  "input_scope": "experiment-brief",
  "requires": [],
  "input": {
    "context": "brief",
    "knowledge": {
      "limit": 2,
      "kinds": [
        "material",
        "solution",
        "process",
        "stack",
        "concept"
      ],
      "query_hint": "objective variables comparison mechanism"
    }
  }
}
