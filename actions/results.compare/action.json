{
  "id": "results.compare",
  "title": "Compare selected result groups",
  "short_title": "Compare groups",
  "category": "results",
  "role": "researcher",
  "visibility": "public",
  "purpose": "Compare selected Results groups from deterministic statistics without calling an AI provider.",
  "strategy": "LabFlow uses only the selected groups and calculated distributions. Contrasts are descriptive; no uncomputed causal or significance claims are produced.",
  "policies": [],
  "contract": {
    "target": {
      "kind": "results_group_selection",
      "cardinality": "many",
      "minimum": 2,
      "selection_param": "groups"
    },
    "context": {
      "profile": "results_compare",
      "scope": "selected_result_groups"
    },
    "result": {
      "format": "json",
      "schema": "results_comparison",
      "kind": "derived_annotation"
    },
    "effect": {
      "mode": "store_derived",
      "writes": [
        "experiment.actionData.annotations.results.compare"
      ]
    },
    "guards": [
      "dataset.loaded",
      "results.compare_groups"
    ]
  },
  "execution": {
    "mode": "deterministic",
    "result_step": "build",
    "steps": [
      {
        "id": "build",
        "type": "DETERMINISTIC",
        "tool": "results.build-comparison",
        "capture_result": true,
        "weight": 0.82
      },
      {
        "id": "store",
        "type": "DETERMINISTIC",
        "tool": "results.store-comparison",
        "weight": 0.18
      }
    ]
  },
  "ui": {
    "command": "/compare",
    "routes": [
      "experiment-results"
    ],
    "bindings": {
      "groups": "ui.boxPlot.groups",
      "metric": "ui.boxPlot.metric",
      "direction": "ui.boxPlot.direction",
      "eligibleOnly": "ui.boxPlot.eligibleOnly"
    }
  }
}
