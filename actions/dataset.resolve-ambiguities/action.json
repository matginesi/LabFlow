{
  "id": "dataset.resolve-ambiguities",
  "type": "HYBRID",
  "category": "dataset",
  "role": "researcher",
  "title": "Suggest resolutions",
  "short_title": "Suggest resolutions",
  "purpose": "Suggest evidence-backed resolutions for records whose canonical meaning the deterministic analysis cannot establish.",
  "strategy": "One bounded Context Pack containing only unresolved findings, linked entities and evidence. AI may answer unresolved; it never writes directly.",
  "output": "json",
  "mutation_scope": "",
  "requires": [
    "dataset.analyze"
  ],
  "policies": [
    "policy.data-ground-truth",
    "policy.data-format-repair",
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.1,
      "tool": "dataset.collect-ambiguities"
    },
    {
      "id": "resolve",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "dataset_corrections",
      "thinking": "on",
      "timeout_ms": 180000,
      "weight": 0.8,
      "max_output_tokens": 4096,
      "deadline_ms": 150000,
      "max_retries": 0,
      "min_output_tokens": 900,
      "target_output_tokens": 1800,
      "max_input_tokens": 8000
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.1,
      "tool": "dataset.store-corrections"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.ambiguities",
  "visibility": "public",
  "input": {
    "context": "ambiguity"
  }
}
