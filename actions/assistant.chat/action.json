{
  "id": "assistant.chat",
  "title": "General experiment assistant",
  "short_title": "Assistant",
  "category": "assistant",
  "role": "assistant",
  "visibility": "internal",
  "purpose": "Answer a question about the current experiment and page without mutating scientific data.",
  "strategy": "One bounded read-only request over current page context, selected experiment evidence and bounded conversation memory.",
  "policies": [
    "policy.scientific-provenance"
  ],
  "contract": {
    "target": {
      "kind": "current_experiment_context",
      "cardinality": "one"
    },
    "context": {
      "profile": "chat",
      "scope": "current_page"
    },
    "result": {
      "format": "text",
      "kind": "assistant_message"
    },
    "effect": {
      "mode": "read_only",
      "writes": []
    },
    "guards": [
      "dataset.loaded",
      "assistant.question"
    ]
  },
  "execution": {
    "mode": "ai",
    "result_step": "chat",
    "steps": [
      {
        "id": "chat",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "text",
        "thinking": "off",
        "timeout_ms": 60000,
        "max_output_tokens": 2048,
        "deadline_ms": 90000,
        "max_retries": 1,
        "min_output_tokens": 100,
        "target_output_tokens": 650,
        "max_input_tokens": 12000
      }
    ]
  }
}
