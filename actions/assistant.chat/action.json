{
  "id": "assistant.chat",
  "type": "AI",
  "title": "General experiment assistant",
  "short_title": "Assistant",
  "purpose": "Answer a question about the current LabFlow experiment and page.",
  "output": "text",
  "policies": [
    "policy.scientific-provenance"
  ],
  "steps": [
    {
      "id": "chat",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "text",
      "timeout_ms": 240000,
      "agent": {
        "mode": "read_only_tools",
        "tools": [
          "experiment.summary",
          "samples.list",
          "sample.get",
          "measurements.query",
          "results.get",
          "findings.list",
          "design.get",
          "document.get",
          "figures.list",
          "evidence.search",
          "provenance.list",
          "nomad.get"
        ],
        "max_rounds": 4,
        "choice_schema": "assistant_tool_choice"
      },
      "max_output_tokens": 4096,
      "deadline_ms": 180000,
      "max_retries": 1
    }
  ],
  "category": "assistant",
  "role": "assistant",
  "strategy": "Read-only tool-aware assistant. The model may inspect the current Canonical Data Model through explicitly allowed read tools, then answer from returned observations. It cannot mutate the Working Copy or invoke write Actions.",
  "mutation_scope": "",
  "visibility": "internal",
  "version": 1,
  "input_scope": "current-page-context",
  "requires": [],
  "input": {
    "context": "assistant"
  }
}
