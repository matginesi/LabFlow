{
  "id": "assistant.chat",
  "title": "General experiment assistant",
  "short_title": "Assistant",
  "category": "assistant",
  "role": "assistant",
  "visibility": "internal",
  "purpose": "Answer questions about the current LabFlow scope after deterministic routing and fact selection.",
  "strategy": "LabFlow answers state/factual questions locally. Only interpretive questions reach one bounded provider request containing a small task-specific fact pack.",
  "policies": [
    "policy.scientific-provenance"
  ],
  "contract": {
    "target": {
      "kind": "current_experiment_context",
      "cardinality": "one"
    },
    "context": {
      "profile": "chat",
      "scope": "resolved_current_scope"
    },
    "result": {
      "format": "text",
      "kind": "assistant_message"
    },
    "effect": {
      "mode": "read_only",
      "writes": []
    },
    "guards": [
      "dataset.loaded",
      "assistant.question"
    ]
  },
  "execution": {
    "mode": "ai",
    "result_step": "chat",
    "steps": [
      {
        "id": "chat",
        "type": "AI",
        "prompt": "prompt.md",
        "output": "text",
        "thinking": "off",
        "timeout_ms": 60000,
        "max_output_tokens": 280,
        "deadline_ms": 70000,
        "max_retries": 0,
        "min_output_tokens": 32,
        "target_output_tokens": 120,
        "max_input_tokens": 1400
      }
    ]
  }
}
