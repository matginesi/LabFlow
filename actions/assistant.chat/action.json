{
  "id": "assistant.chat",
  "type": "AI",
  "title": "General experiment assistant",
  "short_title": "Assistant",
  "purpose": "Answer a question about the current LabFlow experiment and page.",
  "output": "text",
  "policies": [
    "policy.scientific-provenance"
  ],
  "steps": [
    {
      "id": "chat",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "text",
      "thinking": "auto",
      "timeout_ms": 240000,
      "agent": {
        "mode": "read_only_tools",
        "tools": [
          "experiment.summary",
          "samples.list",
          "sample.get",
          "measurements.query",
          "results.get",
          "findings.list",
          "design.get",
          "document.get",
          "figures.list",
          "evidence.search",
          "knowledge.search",
          "provenance.list",
          "nomad.get"
        ],
        "max_rounds": 6,
        "thinking": "off",
        "choice_schema": "assistant_tool_choice"
      },
      "max_output_tokens": 6144,
      "deadline_ms": 180000,
      "max_retries": 1,
      "min_output_tokens": 800,
      "target_output_tokens": 2400
    }
  ],
  "category": "assistant",
  "role": "assistant",
  "strategy": "Read-only tool-aware assistant. It inspects the current Canonical Data Model and may search the always-available local Knowledge Base when the question benefits from LabFlow help or scientific background. A knowledge miss never blocks the answer. The Assistant cannot mutate the Working Copy or invoke write Actions.",
  "mutation_scope": "",
  "visibility": "internal",
  "version": 1,
  "input_scope": "current-page-context",
  "requires": [],
  "input": {
    "context": "assistant"
  }
}
