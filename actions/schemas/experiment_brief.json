{
  "id": "experiment_brief",
  "title": "Compact experiment brief enrichment",
  "type": "object",
  "required": ["summary", "experiment_goal", "variables", "comparisons", "hypotheses", "knowledge_gaps"],
  "properties": {
    "summary": {"type": "string", "maxLength": 180},
    "experiment_goal": {
      "type": "object",
      "required": ["statement", "status"],
      "properties": {
        "statement": {"type": "string", "maxLength": 160},
        "status": {"type": "string", "enum": ["observed", "inferred", "unknown"]}
      }
    },
    "variables": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "maxLength": 70},
          "levels": {"type": "array", "maxItems": 4, "items": {"type": "string", "maxLength": 50}},
          "status": {"type": "string", "enum": ["observed", "inferred", "unknown"]}
        }
      }
    },
    "comparisons": {"type": "array", "maxItems": 2, "items": {"type": "string", "maxLength": 120}},
    "hypotheses": {"type": "array", "maxItems": 2, "items": {"type": "string", "maxLength": 140}},
    "knowledge_gaps": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 100}}
  }
}
