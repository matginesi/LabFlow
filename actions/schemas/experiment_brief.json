{
  "id":"experiment_brief",
  "title":"Reusable experiment brief enrichment",
  "type":"object",
  "required":["summary","experiment_goal","variables","comparisons","interpretations","knowledge_gaps"],
  "properties":{
    "summary":{"type":"string","maxLength":1200},
    "experiment_goal":{"type":"object","required":["statement","status","confidence"],"properties":{
      "statement":{"type":"string","maxLength":800},
      "status":{"type":"string","enum":["observed","inferred","unknown"]},
      "confidence":{"type":"number","minimum":0,"maximum":1},
      "basis":{"type":"array","maxItems":5,"items":{"type":"string","maxLength":500}}
    }},
    "variables":{"type":"array","maxItems":12,"items":{"type":"object","required":["name","role","status","confidence"],"properties":{
      "name":{"type":"string","maxLength":200},
      "role":{"type":"string","maxLength":500},
      "levels":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":160}},
      "status":{"type":"string","enum":["observed","inferred","unknown"]},
      "confidence":{"type":"number","minimum":0,"maximum":1},
      "basis":{"type":"array","maxItems":5,"items":{"type":"string","maxLength":500}}
    }}},
    "comparisons":{"type":"array","maxItems":12,"items":{"type":"object","required":["label","why_useful","status","confidence"],"properties":{
      "label":{"type":"string","maxLength":300},
      "why_useful":{"type":"string","maxLength":700},
      "status":{"type":"string","enum":["observed","inferred"]},
      "confidence":{"type":"number","minimum":0,"maximum":1},
      "basis":{"type":"array","maxItems":5,"items":{"type":"string","maxLength":500}}
    }}},
    "interpretations":{"type":"array","maxItems":10,"items":{"type":"object","required":["statement","kind","confidence"],"properties":{
      "statement":{"type":"string","maxLength":800},
      "kind":{"type":"string","enum":["observation","hypothesis"]},
      "confidence":{"type":"number","minimum":0,"maximum":1},
      "basis":{"type":"array","maxItems":5,"items":{"type":"string","maxLength":500}}
    }}},
    "knowledge_gaps":{"type":"array","maxItems":16,"items":{"type":"string","maxLength":500}},
    "recommended_focus":{"type":"array","maxItems":8,"items":{"type":"string","maxLength":500}}
  }
}
