{
  "id": "design_infer",
  "title": "Design suggestion",
  "type": "object",
  "required": [
    "summary",
    "solutions",
    "devices",
    "unknowns"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 260
    },
    "solutions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "name",
          "provenance_kind",
          "confidence",
          "reason"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "solutes": {
            "type": "string"
          },
          "solvents": {
            "type": "string"
          },
          "concentration": {
            "type": "string"
          },
          "additives": {
            "type": "string"
          },
          "preparation": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "knowledge_refs": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance_kind": {
            "type": "string",
            "enum": [
              "experiment",
              "knowledge",
              "model_inference"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 180
          }
        }
      }
    },
    "devices": {
      "type": "array",
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "provenance_kind",
          "confidence",
          "reason",
          "stack"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "sample_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "solution_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "stack": {
            "type": "array",
            "maxItems": 14,
            "items": {
              "type": "object",
              "required": [
                "role",
                "provenance_kind",
                "confidence",
                "reason"
              ],
              "properties": {
                "role": {
                  "type": "string"
                },
                "material": {
                  "type": "string"
                },
                "thickness": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "knowledge_refs": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "provenance_kind": {
                  "type": "string",
                  "enum": [
                    "experiment",
                    "knowledge",
                    "model_inference"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 180
                }
              }
            }
          },
          "evidence": {
            "type": "string"
          },
          "knowledge_refs": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "string"
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance_kind": {
            "type": "string",
            "enum": [
              "experiment",
              "knowledge",
              "model_inference"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 180
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 140
      }
    }
  }
}
