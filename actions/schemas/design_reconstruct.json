{
  "id": "design_infer",
  "title": "Compact Design suggestion",
  "type": "object",
  "required": ["summary", "solutions", "devices", "unknowns"],
  "properties": {
    "summary": {"type": "string", "maxLength": 180},
    "solutions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["name", "provenance_kind", "confidence", "reason"],
        "properties": {
          "name": {"type": "string", "maxLength": 80},
          "role": {"type": "string", "maxLength": 60},
          "solutes": {"type": "string", "maxLength": 120},
          "solvents": {"type": "string", "maxLength": 100},
          "concentration": {"type": "string", "maxLength": 60},
          "knowledge_refs": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 80}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "provenance_kind": {"type": "string", "enum": ["experiment", "knowledge", "model_inference"]},
          "reason": {"type": "string", "maxLength": 120}
        }
      }
    },
    "devices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": ["provenance_kind", "confidence", "reason", "stack"],
        "properties": {
          "stack": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "required": ["role", "provenance_kind", "confidence", "reason"],
              "properties": {
                "role": {"type": "string", "maxLength": 60},
                "material": {"type": "string", "maxLength": 80},
                "thickness": {"type": "string", "maxLength": 50},
                "knowledge_refs": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 80}},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1},
                "provenance_kind": {"type": "string", "enum": ["experiment", "knowledge", "model_inference"]},
                "reason": {"type": "string", "maxLength": 100}
              }
            }
          },
          "knowledge_refs": {"type": "array", "maxItems": 3, "items": {"type": "string", "maxLength": 80}},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "provenance_kind": {"type": "string", "enum": ["experiment", "knowledge", "model_inference"]},
          "reason": {"type": "string", "maxLength": 120}
        }
      }
    },
    "unknowns": {"type": "array", "maxItems": 6, "items": {"type": "string", "maxLength": 100}}
  }
}
