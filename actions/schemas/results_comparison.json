{
  "id": "results_comparison",
  "title": "Structured group comparison",
  "type": "object",
  "required": [
    "status",
    "summary",
    "contrasts",
    "hypotheses",
    "limitations",
    "next_checks"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "compared",
        "insufficient_evidence"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "groups": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    },
    "contrasts": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": [
          "statement",
          "evidence",
          "confidence"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 260
          },
          "evidence": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 140
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "hypotheses": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "required": [
          "statement",
          "basis",
          "confidence"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "maxLength": 260
          },
          "basis": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "string",
              "maxLength": 140
            }
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 220
      }
    },
    "next_checks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 220
      }
    }
  }
}
