{
  "id": "design_suggestion",
  "title": "Design suggestion",
  "type": "object",
  "required": [
    "status",
    "summary",
    "solutions",
    "stack",
    "process",
    "unresolved_domains",
    "unknowns"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "suggested"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 260
    },
    "solutions": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": [
          "name",
          "role",
          "solutes",
          "solvents"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string"
          },
          "solutes": {
            "type": "string"
          },
          "solvents": {
            "type": "string"
          },
          "concentration": {
            "type": "string"
          },
          "additives": {
            "type": "string"
          },
          "preparation": {
            "type": "string",
            "maxLength": 500
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance_kind": {
            "type": "string",
            "enum": [
              "experiment",
              "cabinet_reference",
              "knowledge_reference",
              "model_inference"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 180
          }
        },
        "additionalProperties": false
      }
    },
    "stack": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "role",
          "material"
        ],
        "properties": {
          "role": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "thickness": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "provenance_kind": {
            "type": "string",
            "enum": [
              "experiment",
              "cabinet_reference",
              "knowledge_reference",
              "model_inference"
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 180
          }
        },
        "additionalProperties": false
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "coating": {
          "type": "string"
        },
        "annealing": {
          "type": "string"
        },
        "atmosphere": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance_kind": {
          "type": "string",
          "enum": [
            "experiment",
            "cabinet_reference",
            "knowledge_reference",
            "model_inference"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 180
        }
      },
      "additionalProperties": false
    },
    "unresolved_domains": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "solutions",
          "stack",
          "process"
        ]
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 160
      }
    }
  },
  "additionalProperties": false
}
