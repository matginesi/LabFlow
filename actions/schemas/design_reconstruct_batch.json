{
  "id": "design_infer_batch",
  "title": "Batch missing design proposals",
  "type": "object",
  "required": [
    "summary",
    "proposals"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 500
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": [
          "target_device_id",
          "summary",
          "solutions",
          "device",
          "unknowns"
        ],
        "properties": {
          "target_device_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "maxLength": 300
          },
          "solutions": {
            "type": "array",
            "maxItems": 8,
            "items": {
              "type": "object",
              "required": [
                "name",
                "provenance_kind",
                "confidence",
                "reason"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "solutes": {
                  "type": "string"
                },
                "solvents": {
                  "type": "string"
                },
                "concentration": {
                  "type": "string"
                },
                "additives": {
                  "type": "string"
                },
                "preparation": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "knowledge_refs": {
                  "type": "array",
                  "maxItems": 6,
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "field_confidence": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "provenance_kind": {
                  "type": "string",
                  "enum": [
                    "experiment",
                    "knowledge",
                    "model_inference"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 240
                }
              }
            }
          },
          "device": {
            "type": "object",
            "required": [
              "provenance_kind",
              "confidence",
              "reason"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sample_names": {
                "description": "Optional provider echo. LabFlow deterministically binds the proposal to the selected Design variant after validation.",
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "group": {
                "type": "string"
              },
              "solution_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "process": {
                "type": "object",
                "properties": {
                  "coating": {
                    "type": "string"
                  },
                  "annealing": {
                    "type": "string"
                  },
                  "atmosphere": {
                    "type": "string"
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              },
              "stack": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "provenance_kind",
                    "confidence",
                    "reason"
                  ],
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "material": {
                      "type": "string"
                    },
                    "thickness": {
                      "type": "string"
                    },
                    "process": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "string"
                    },
                    "knowledge_refs": {
                      "type": "array",
                      "maxItems": 6,
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "field_confidence": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    },
                    "provenance_kind": {
                      "type": "string",
                      "enum": [
                        "experiment",
                        "knowledge",
                        "model_inference"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 240
                    }
                  }
                }
              },
              "evidence": {
                "type": "string"
              },
              "knowledge_refs": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "field_confidence": {
                "type": "object",
                "additionalProperties": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "provenance_kind": {
                "type": "string",
                "enum": [
                  "experiment",
                  "knowledge",
                  "model_inference"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 240
              }
            }
          },
          "unknowns": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      }
    }
  }
}
