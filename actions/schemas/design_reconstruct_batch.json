{
  "id": "design_infer_batch",
  "title": "Batch Design suggestions",
  "type": "object",
  "required": [
    "summary",
    "proposals"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "maxLength": 350
    },
    "proposals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "target_device_id",
          "summary",
          "solutions",
          "unknowns"
        ],
        "properties": {
          "target_device_id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "maxLength": 240
          },
          "solutions": {
            "type": "array",
            "maxItems": 6,
            "items": {
              "type": "object",
              "required": [
                "name",
                "provenance_kind",
                "confidence",
                "reason"
              ],
              "properties": {
                "name": {
                  "type": "string"
                },
                "role": {
                  "type": "string"
                },
                "solutes": {
                  "type": "string"
                },
                "solvents": {
                  "type": "string"
                },
                "concentration": {
                  "type": "string"
                },
                "additives": {
                  "type": "string"
                },
                "preparation": {
                  "type": "string"
                },
                "evidence": {
                  "type": "string"
                },
                "knowledge_refs": {
                  "type": "array",
                  "maxItems": 5,
                  "items": {
                    "type": "string"
                  }
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                },
                "provenance_kind": {
                  "type": "string",
                  "enum": [
                    "experiment",
                    "knowledge",
                    "model_inference"
                  ]
                },
                "reason": {
                  "type": "string",
                  "maxLength": 180
                }
              }
            }
          },
          "device": {
            "type": "object",
            "required": [
              "provenance_kind",
              "confidence",
              "reason",
              "stack"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "sample_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "solution_names": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "stack": {
                "type": "array",
                "maxItems": 14,
                "items": {
                  "type": "object",
                  "required": [
                    "role",
                    "provenance_kind",
                    "confidence",
                    "reason"
                  ],
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "material": {
                      "type": "string"
                    },
                    "thickness": {
                      "type": "string"
                    },
                    "evidence": {
                      "type": "string"
                    },
                    "knowledge_refs": {
                      "type": "array",
                      "maxItems": 5,
                      "items": {
                        "type": "string"
                      }
                    },
                    "confidence": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "provenance_kind": {
                      "type": "string",
                      "enum": [
                        "experiment",
                        "knowledge",
                        "model_inference"
                      ]
                    },
                    "reason": {
                      "type": "string",
                      "maxLength": 180
                    }
                  }
                }
              },
              "evidence": {
                "type": "string"
              },
              "knowledge_refs": {
                "type": "array",
                "maxItems": 6,
                "items": {
                  "type": "string"
                }
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "provenance_kind": {
                "type": "string",
                "enum": [
                  "experiment",
                  "knowledge",
                  "model_inference"
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 180
              }
            }
          },
          "unknowns": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "string",
              "maxLength": 140
            }
          }
        }
      }
    }
  }
}
