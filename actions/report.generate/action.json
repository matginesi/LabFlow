{
  "id": "report.generate",
  "type": "HYBRID",
  "category": "report",
  "role": "researcher",
  "title": "Draft document",
  "short_title": "Draft document",
  "purpose": "Draft the active Lab Report or Scientific Paper from the current Experiment Brief, deterministic results, design provenance and findings.",
  "strategy": "Deterministically split the requested document into bounded writing blocks. The model writes one block at a time from the same evidence pack; LabFlow then assembles the blocks in order.",
  "output": "text",
  "mutation_scope": "report",
  "policies": [
    "policy.scientific-provenance"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.08,
      "tool": "report.collect-draft-blocks"
    },
    {
      "id": "draft",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "text",
      "thinking": "off",
      "timeout_ms": 240000,
      "foreach": "collect.blocks",
      "weight": 0.84,
      "max_output_tokens": 12288,
      "deadline_ms": 180000,
      "max_retries": 1,
      "min_output_tokens": 1800,
      "target_output_tokens": 6500
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.08,
      "capture_result": true,
      "tool": "report.store-draft-blocks"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.report-context",
  "visibility": "public",
  "requires": [],
  "input": {
    "context": "report"
  }
}
