{
  "id": "design.infer-batch",
  "type": "HYBRID",
  "category": "design",
  "role": "researcher",
  "title": "Suggest experiment designs",
  "short_title": "Suggest designs",
  "purpose": "Suggest missing solution chemistry and device stacks for a small group of experiments in one bounded request.",
  "strategy": "At most six experiments per request. Successful suggestions are stored independently; an omitted experiment is marked for retry instead of invalidating the whole batch.",
  "output": "json",
  "mutation_scope": "",
  "policies": [
    "policy.scientific-provenance",
    "policy.structured-output"
  ],
  "steps": [
    {
      "id": "collect",
      "type": "DETERMINISTIC",
      "weight": 0.08,
      "tool": "design.collect-batch"
    },
    {
      "id": "infer",
      "type": "AI",
      "prompt": "prompt.md",
      "output": "json",
      "schema": "design_reconstruct_batch",
      "thinking": "off",
      "timeout_ms": 90000,
      "weight": 0.82,
      "max_output_tokens": 3000,
      "deadline_ms": 75000,
      "max_retries": 0,
      "min_output_tokens": 200,
      "target_output_tokens": 1200
    },
    {
      "id": "validate",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.validate-batch"
    },
    {
      "id": "store",
      "type": "DETERMINISTIC",
      "weight": 0.05,
      "tool": "design.store-batch-proposals"
    }
  ],
  "version": 1,
  "input_scope": "working-copy.design-batch",
  "visibility": "internal",
  "requires": [],
  "input": {
    "context": "design-batch",
    "knowledge": {
      "limit": 5,
      "kinds": [
        "material",
        "solution",
        "stack",
        "concept"
      ],
      "query_hint": "solution solvent solute precursor stack layer material"
    }
  }
}
